{
  "info": {
    "name": "PROC Payment API",
    "description": "Payment processing API collection. Uses HMAC-SHA256 signature authentication.\n\nRequired environment variables:\n- BASE_URL: https://papiv3preprod.testpaygate.com\n- TERMINAL_ID: your terminal ID\n- SERVICE_SECRET: your signing secret\n- WEBPAY_BASE_URL: https://web3preprod.testpaygate.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://papiv3preprod.testpaygate.com",
      "type": "string"
    },
    {
      "key": "WEBPAY_BASE_URL",
      "value": "https://web3preprod.testpaygate.com",
      "type": "string"
    },
    {
      "key": "TERMINAL_ID",
      "value": "374",
      "type": "string"
    },
    {
      "key": "SERVICE_SECRET",
      "value": "",
      "type": "string"
    },
    {
      "key": "transaction_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscription_token",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ── Signature helper (runs before every request) ──",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const terminalId = pm.variables.get('TERMINAL_ID');",
          "const secret = pm.variables.get('SERVICE_SECRET');",
          "",
          "// Build raw body string (empty string for GET/DELETE)",
          "let rawBody = '';",
          "if (pm.request.body && pm.request.body.raw) {",
          "    rawBody = pm.request.body.raw;",
          "    // Resolve any {{variable}} references in body before signing",
          "    rawBody = pm.variables.replaceIn(rawBody);",
          "}",
          "",
          "const message = timestamp + terminalId + rawBody;",
          "const signature = CryptoJS.HmacSHA256(message, secret).toString(CryptoJS.enc.Hex);",
          "",
          "pm.request.headers.upsert({ key: 'Api-Terminal-ID',    value: terminalId });",
          "pm.request.headers.upsert({ key: 'Api-Timestamp',      value: timestamp });",
          "pm.request.headers.upsert({ key: 'Api-Signature',      value: signature });",
          "",
          "// Add Idempotency-Key for mutating methods",
          "if (['POST','PUT','PATCH'].includes(pm.request.method)) {",
          "    const idempotencyKey = pm.variables.replaceIn('{{$guid}}');",
          "    pm.request.headers.upsert({ key: 'Api-Idempotency-Key', value: idempotencyKey });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create Payin (card)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.transaction_id) {",
                  "        pm.collectionVariables.set('transaction_id', json.transaction_id);",
                  "        console.log('Saved transaction_id:', json.transaction_id);",
                  "    }",
                  "    if (json.transaction_data && json.transaction_data.recurrent_token) {",
                  "        pm.collectionVariables.set('subscription_token', json.transaction_data.recurrent_token);",
                  "        console.log('Saved subscription_token:', json.transaction_data.recurrent_token);",
                  "    }",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payin\",\n  \"merchant_data\": {\n    \"order_id\": \"order_{{$randomInt}}\",\n    \"description\": \"Test payin\",\n    \"webhook_url\": \"https://webhook.site/your-uuid\",\n    \"return_url\": \"https://example.com/return\"\n  },\n  \"financial_data\": {\n    \"amount\": 10000,\n    \"currency\": \"RUB\"\n  },\n  \"customer_data\": {\n    \"contact_info\": {\n      \"email\": \"test@example.com\",\n      \"phone\": \"+19991231212\"\n    },\n    \"browser_info\": {\n      \"screen_height\": 1080,\n      \"screen_width\": 1920,\n      \"time_zone\": -120,\n      \"color_depth\": 24,\n      \"user_agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64)\",\n      \"accept_header\": \"application/json\",\n      \"java_enabled\": false,\n      \"java_script_enabled\": true,\n      \"ip\": \"192.168.1.1\",\n      \"language\": \"en-US\"\n    }\n  },\n  \"transaction_data\": {\n    \"method\": \"card\",\n    \"details\": {\n      \"pan\": \"4111111111111111\",\n      \"holder\": \"JOHN DOE\",\n      \"expiry_month\": \"12\",\n      \"expiry_year\": \"26\",\n      \"cvv\": \"123\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
