                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.link_id) {",
                  "        pm.collectionVariables.set('link_id', json.link_id);",
                  "    }",
                  "    console.log('Payment URL:', json.link_data && json.link_data.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant_data\": {\n    \"order_id\": \"order_{{$randomInt}}\",\n    \"description\": \"Payment for order\",\n    \"return_url\": \"https://example.com/return\"\n  },\n  \"financial_data\": {\n    \"amount\": 10000,\n    \"currency\": \"RUB\"\n  },\n  \"customer_data\": {\n    \"contact_info\": {\n      \"email\": \"test@example.com\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{WEBPAY_BASE_URL}}/api/v1/payment-links",
              "host": ["{{WEBPAY_BASE_URL}}"],
              "path": ["api", "v1", "payment-links"]
            },
            "description": "Create a hosted payment page link. Response contains link_data.url for the customer."
          }
        }
      ]
    },
