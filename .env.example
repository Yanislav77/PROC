# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env          (Mac / Linux)
#   copy .env.example .env        (Windows)

SERVICE_SECRET=вставьте_сюда_секрет
TERMINAL_ID=374
CUSTOMER_MAC_KEY=вставьте_сюда_customer_mac_key

# Legacy (old PAPI) credentials — только для parity-тестов CON-078..081
# Оставьте пустыми, если не нужны — тесты автоматически пропустятся (SKIP)
LEGACY_TERMINAL_ID=
LEGACY_SERVICE_SECRET=

DB_HOST=вставьте_сюда_хост
DB_USER=postgres
DB_PASSWORD=вставьте_сюда_пароль

REDIS_HOST=вставьте_сюда_хост
REDIS_PORT=6379
REDIS_USER=вставьте_сюда_пользователя
REDIS_PASSWORD=вставьте_сюда_пароль
